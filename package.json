{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "description": "Render yozora markdown ast into html strings.",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-html.git"
  },
  "homepage": "https://github.com/yozorajs/yozora-html/#readme",
  "license": "MIT",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || ^26.0.0"
  },
  "type": "module",
  "scripts": {
    ":publish": "pnpm run :publish:prepare && pnpm run :publish:verify && pnpm run :publish:execute",
    ":publish-recover": "pnpm run :publish",
    ":upgrade": "pnpm update -i && pnpm clean && pnpm format && pnpm build && pnpm test",
    "build": "pnpm -r run build",
    "build:production": "pnpm -r run build:production",
    "clean": "pnpm -r run clean",
    "format": "pnpm format:lintfix && pnpm format:prettier",
    "format:lintfix": "eslint . --fix",
    "format:prettier": "prettier --write .",
    "postinstall": "husky",
    "rebuild": "pnpm clean && pnpm build",
    "run:ts": "node --loader ts-node/esm",
    "test": "pnpm -r run --if-present test",
    "test:coverage": "pnpm -r run --if-present test:coverage",
    "test:update": "pnpm -r run --if-present test:update",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:build": "node script/verify-build.mjs",
    ":publish:prepare": "pnpm clean && pnpm typecheck && pnpm build:production",
    ":publish:verify": "pnpm test:build && pnpm test:coverage",
    ":publish:execute": "pnpm -r publish --publish-branch main",
    "docs:links": "ghc-doc-link-rewrite --username=yozorajs --repository=yozora-html"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@guanghechen/script-doc-link": "^6.1.0",
    "@types/node": "24.13.4",
    "@types/prismjs": "1.26.6",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "5.0.0",
    "@yozora/ast": "^2.4.0",
    "@yozora/ast-util": "^2.4.0",
    "@yozora/html-markdown": "workspace:*",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "sanitize-html": "2.17.7",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,eslintrc}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.3.4"
}
