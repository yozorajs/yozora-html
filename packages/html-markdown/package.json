{
  "name": "@yozora/html-markdown",
  "version": "2.0.0-alpha.13",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-html.git",
    "directory": "packages/html-markdown"
  },
  "homepage": "https://github.com/yozorajs/yozora-html/tree/main/packages/html-markdown#readme",
  "keywords": [
    "mdast to html",
    "yozora"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./style.css": "./lib/index.css",
    "./tailwind.css": "./lib/tailwind.css",
    "./lib/index.css": "./lib/index.css"
  },
  "source": "./src/index.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./lib/types/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs --sourcemap",
    "build:production": "tsdown --config ../../tsdown.config.mjs --no-sourcemap",
    "clean": "node ../../script/clean.mjs",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  },
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@yozora/ast": "^2.0.0"
  },
  "dependencies": {
    "prismjs": "1.30.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/prismjs": "1.26.6",
    "@types/sanitize-html": "2.16.1",
    "@yozora/ast": "^2.4.0",
    "@yozora/ast-util": "^2.4.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
