{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/__test__", "vitest.config.ts", "vitest.setup.ts"]
}
