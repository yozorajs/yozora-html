{
  "name": "@yozora/core-html-renderer",
  "version": "2.0.0-alpha.13",
  "description": "Yozora renderer in html",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-html.git",
    "directory": "packages/core-html-renderer"
  },
  "homepage": "https://github.com/yozorajs/yozora-html/tree/main/packages/core-html-renderer#readme",
  "keywords": [
    "mdast to html",
    "yozora"
  ],
  "type": "module",
  "exports": {
    "types": "./lib/types/index.d.ts",
    "import": "./lib/esm/index.mjs",
    "require": "./lib/cjs/index.cjs"
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@yozora/ast": "^2.0.0"
  },
  "dependencies": {
    "prismjs": "1.30.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/prismjs": "1.26.6",
    "@types/sanitize-html": "2.16.1"
  },
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --mode development",
    "build:production": "vite build --config ../../vite.config.ts",
    "clean": "node ../../script/clean.mjs",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  }
}
